{
  "name": "dlap-ui",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@subframe/core": "^1.147.0",
    "axios": "^1.20.0",
    "date-fns": "^3.0.0",
    "keycloak-js": "^26.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.8.0",
    "sockjs-client": "^1.6.1",
    "stompjs": "^2.3.3",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ci": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "gen:api": "npm run gen:api:catalog && npm run gen:api:reporting && npm run gen:api:policyengine && npm run gen:api:autodelete",
    "gen:api:check": "npm run gen:api:catalog -- --check && npm run gen:api:reporting -- --check && npm run gen:api:policyengine -- --check && npm run gen:api:autodelete -- --check",
    "gen:api:catalog": "openapi-typescript ../../docs/api/openapi/catalog.json -o src/api/generated/catalog.ts --root-types --root-types-no-schema-prefix --root-types-keep-casing",
    "gen:api:reporting": "openapi-typescript ../../docs/api/openapi/reporting.json -o src/api/generated/reporting.ts --root-types --root-types-no-schema-prefix --root-types-keep-casing",
    "gen:api:policyengine": "openapi-typescript ../../docs/api/openapi/policyengine.json -o src/api/generated/policyengine.ts --root-types --root-types-no-schema-prefix --root-types-keep-casing",
    "gen:api:autodelete": "openapi-typescript ../../docs/api/openapi/autodelete.json -o src/api/generated/autodelete.ts --root-types --root-types-no-schema-prefix --root-types-keep-casing"
  },
  "overrides": {
    "follow-redirects": "^1.16.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sockjs-client": "^1.5.4",
    "@types/stompjs": "^2.3.9",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.16",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "openapi-typescript": "7.13.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.9"
  }
}
