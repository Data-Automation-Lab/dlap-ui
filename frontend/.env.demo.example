# Demo build of the DLAP UI (work package DEMO-03). Public values only.
#
# A browser app cannot keep a secret: Vite compiles every VITE_* and REACT_APP_*
# value into the public bundle. Never put a password, token or API key in this
# file or in the .env.demo copy made from it.
#
# Build the demo SPA:
#   cp .env.demo.example .env.demo     (.env.demo is git-ignored; edit the hosts)
#   npm run build -- --mode demo
# or without a file:
#   VITE_DEMO_MODE=true REACT_APP_API_BASE_URL=https://demo.example.org npm run build
#
# With VITE_DEMO_MODE=true every page shows the demo banner and only the pages in
# src/demo/pageAllowlist.ts are reachable. With the variable unset or any other
# value the application is unchanged.

VITE_DEMO_MODE=true

# Public origin of the demo gateway. Use an absolute URL: an empty value falls
# back to http://localhost:8081 (src/utils/api.ts).
REACT_APP_API_BASE_URL=https://demo.example.org

# Public origin, realm and public client of the demo Keycloak. The realm and
# client names must match the realm the demo imports (DEMO-02,
# dlap-demo-realm.json); dlap-demo is the expected name, confirm it there.
REACT_APP_KEYCLOAK_URL=https://id.example.org
REACT_APP_KEYCLOAK_REALM=dlap-demo
REACT_APP_KEYCLOAK_CLIENT_ID=dlap-ui

# Must stay false: the demo shows stored data only, never client-side mock data.
REACT_APP_ENABLE_MOCK_DATA=false
REACT_APP_ENABLE_DEBUG_LOGS=false
