# Keep text files LF in repo (matches Linux/WSL and avoids spurious diffs on Windows).
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf

# Binaries
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.jar binary
