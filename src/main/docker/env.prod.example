# Production Environment Variables for Docker Compose
# Copy this file to .env in the same directory and modify with secure values

# Keycloak Configuration
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_SECURE_PASSWORD
KEYCLOAK_HOSTNAME=auth.dalab.com
KEYCLOAK_HTTPS_PORT=8443
KEYCLOAK_HTTP_PORT=8080

# Database Configuration
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=CHANGE_ME_SECURE_DB_PASSWORD
POSTGRES_PORT=5432

# Redis Configuration (optional)
REDIS_PASSWORD=CHANGE_ME_SECURE_REDIS_PASSWORD
REDIS_PORT=6379

# Logging
KC_LOG_LEVEL=WARN

# Production specific settings
COMPOSE_PROJECT_NAME=dlap-prod
COMPOSE_FILE=docker-compose.prod.yml

# SSL/TLS Configuration
# Ensure SSL certificates are placed in ./ssl-certs/ directory
# - server.crt.pem (certificate file)
# - server.key.pem (private key file)

# Security Notes:
# 1. Change all default passwords
# 2. Use strong, unique passwords for each service
# 3. Ensure SSL certificates are properly configured
# 4. Review and configure firewall rules
# 5. Enable monitoring and logging
# 6. Regular security updates and patches 